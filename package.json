{
  "name": "pi-remote-kernel",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Pi SDK host for remote Python kernel tools",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-pi.mjs",
    "start": "node src/main.ts",
    "gateway": "node src/main.ts gateway",
    "attach": "node src/main.ts attach",
    "web": "node src/main.ts web",
    "check:native:sdk": "node tests/sessions/check-native-interactions.mjs",
    "check:native:web": "node tests/web/check-native-web-interactions.mjs",
    "check:gateway:workers": "node tests/gateway/check-gateway.mjs",
    "check:derived": "node tests/sessions/check-derived-sessions.mjs",
    "check:sessions": "node tests/sessions/check-worker-space.mjs && node tests/sessions/check-derived-sessions.mjs",
    "check:idle": "node tests/sessions/check-idle-resume.mjs",
    "check:targets:reload": "node tests/gateway/check-target-reload.mjs",
    "check:recovery": "node tests/sessions/check-recovery-protocol.mjs && node tests/sessions/check-recovery-runtime.mjs && node tests/sessions/check-workspace-retarget.mjs && node tests/kernel/check-kernel-recovery.mjs",
    "check:web:recovery": "PI_TEST_RECOVERY_BROWSER=1 node tests/kernel/check-kernel-recovery.mjs",
    "check:web:idle": "PI_TEST_IDLE_BROWSER=1 node tests/sessions/check-idle-resume.mjs",
    "check:history": "node tests/sessions/check-worker-history-storage.mjs && node tests/sessions/check-history-protocol.mjs && node tests/sessions/check-gateway-history.mjs",
    "check:web": "node tests/web/check-web-workbench.mjs",
    "check:web:history": "node tests/web/check-web-history.mjs",
    "check:web:server": "node tests/web/web-server-smoke.ts",
    "check:transport": "node tests/gateway/check-gateway.mjs",
    "check:gateway:live": "node tests/gateway/check-gateway-live.mjs",
    "check": "tsc --noEmit",
    "check:config": "node tests/workers/check-prk-config.mjs",
    "check:workspace": "node tests/workspace/check-workspace-proxy.mjs",
    "check:host": "node tests/sessions/check-session-host.mjs",
    "check:workers:lifecycle": "node tests/workers/check-worker-lifecycle.mjs",
    "check:kernel-close": "node tests/kernel/check-lifecycle.mjs",
    "check:unit": "node scripts/check-unit.mjs",
    "check:quick": "node tests/docs/check-contract.mjs && node scripts/check-quick.mjs",
    "check:ui-probe:types": "tsc --noEmit -p tests/fixtures/pi-ui-probe/tsconfig.json",
    "check:ui-probe:components": "node tests/fixtures/pi-ui-probe/check-components.mjs",
    "check:ui-probe": "npm run check:ui-probe:types && npm run check:ui-probe:components",
    "check:extension-ui": "node tests/web/check-extension-ui.mjs",
    "check:extension-ui:web": "node tests/web/check-extension-ui.mjs --browser",
    "check:full": "node scripts/check-quick.mjs --full"
  },
  "dependencies": {
    "@earendil-works/chord": "1.6.0",
    "@earendil-works/pi-agent-core": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-env": "1.6.0",
    "@xterm/headless": "^6.0.0",
    "colorjs.io": "^0.7.1",
    "content-disposition": "3.1.0",
    "mime": "4.1.2",
    "smol-toml": "^1.9.1",
    "typebox": "^1.4.7",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
